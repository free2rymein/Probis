{
  "name": "@probis/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
