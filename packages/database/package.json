    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
