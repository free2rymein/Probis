{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@probis/ui": ["../../packages/ui/src/index.ts"],
      "@probis/ui/*": ["../../packages/ui/src/*"],
      "@probis/types": ["../../packages/types/src/index.ts"],
      "@probis/types/*": ["../../packages/types/src/*"],
      "@probis/shared": ["../../packages/shared/src/index.ts"],
      "@probis/shared/*": ["../../packages/shared/src/*"],
      "@probis/intelligence": ["../../packages/intelligence/src/index.ts"],
      "@probis/intelligence/*": ["../../packages/intelligence/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
