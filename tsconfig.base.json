{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@probis/ui": ["packages/ui/src/index.ts"],
      "@probis/ui/*": ["packages/ui/src/*"],
      "@probis/types": ["packages/types/src/index.ts"],
      "@probis/types/*": ["packages/types/src/*"],
      "@probis/shared": ["packages/shared/src/index.ts"],
      "@probis/shared/*": ["packages/shared/src/*"],
      "@probis/database": ["packages/database/src/index.ts"],
      "@probis/database/*": ["packages/database/src/*"],
      "@probis/intelligence": ["packages/intelligence/src/index.ts"],
      "@probis/intelligence/*": ["packages/intelligence/src/*"]
    }
  }
}
