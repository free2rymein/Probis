DATABASE_URL=postgresql://postgres:postgres@localhost:5432/probis
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
EVENTS_QUERY_MODE=read-model-with-legacy-fallback
LOG_LEVEL=info
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
MARKET_FETCH_LIMIT=100
MAX_MARKET_FETCH_PAGES=100
POLYMARKET_EVENT_PAGE_LIMIT=100
POLYMARKET_EVENT_MAX_PAGES=10
MARKET_DISCOVERY_INTERVAL_MS=900000
MARKET_SNAPSHOT_INTERVAL_MS=300000
HTTP_TIMEOUT_MS=15000
MIN_EVENT_VOLUME=5000
MIN_EVENT_LIQUIDITY=500
MIN_EVENT_VOLUME_24H=0
LIFECYCLE_RECONCILE_LIMIT=25
LIFECYCLE_RECONCILE_CONCURRENCY=5
LIFECYCLE_RECONCILE_STALE_MINUTES=60
CLOSED_EVENT_PAGE_LIMIT=100
CLOSED_EVENT_MAX_PAGES=10
OPEN_FEED_STALE_GRACE_MINUTES=60
STALE_CLOSE_END_DATE_BUFFER_HOURS=6
ENABLE_SET_BASED_STALE_CLOSE=false
GAMMA_INGESTION_MODE=direct
GAMMA_STAGING_ENABLED=false
GAMMA_STAGING_REFRESH_INTERVAL_MS=300000
RAW_STAGING_RETENTION_MINUTES=60
RAW_STAGING_KEEP_SUCCESSFUL_BATCHES=2
RAW_FAILED_STAGING_RETENTION_MINUTES=360
RAW_STAGING_CLEANUP_MODE=retain-latest
RAW_STAGING_READ_PAGE_SIZE=250
RAW_STAGING_WRITE_PAGE_SIZE=250
RAW_STAGING_STATUS_UPDATE_BATCH_SIZE=1000
RELATIONSHIP_SYNC_BATCH_SIZE=1000
# Supported: stored-procedure, staging-db, memory. Recommended/default path: stored-procedure.
PIPELINE_NORMALIZATION_SOURCE=stored-procedure
INGESTION_BATCH_RETENTION_DAYS=7
